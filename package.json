{
  "name": "@ratmath/algebraic",
  "version": "0.1.0",
  "description": "Exact algebraic numbers (real and complex), exact trigonometry, polynomial factoring, Galois groups, continued fractions, number fields and finite fields for RatMath",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./poly": "./src/poly.js",
    "./qpoly": "./src/qpoly.js",
    "./complex": "./src/complex.js",
    "./interval": "./src/interval.js",
    "./q": "./src/q.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js"
  },
  "keywords": [
    "algebraic-numbers",
    "exact",
    "polynomial",
    "factoring",
    "number-field",
    "finite-field",
    "sturm",
    "resultant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/algebraic.git"
  },
  "homepage": "https://github.com/ratmath/algebraic#readme",
  "dependencies": {
    "@ratmath/core": "^0.8.0"
  },
  "devDependencies": {
    "katex": "0.19.1"
  }
}
