{
  "name": "@ratmath/algebraic",
  "version": "0.1.0",
  "description": "Exact algebraic numbers (real and complex), exact trigonometry, polynomial factoring, Galois groups, continued fractions, number fields and finite fields for RatMath",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./poly": "./src/poly.js",
    "./qpoly": "./src/qpoly.js",
    "./complex": "./src/complex.js",
    "./interval": "./src/interval.js",
    "./q": "./src/q.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js"
  },
  "keywords": [
    "algebraic-numbers",
    "exact",
    "polynomial",
    "factoring",
    "number-field",
    "finite-field",
    "sturm",
    "resultant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/algebraic.git"
  },
  "homepage": "https://ratmath.com/algebraic/",
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/ratmath/algebraic/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
